#!/usr/bin/env bash
set -euo pipefail

gopass_get() {
    if [ "$#" -eq 1 ]; then
        gopass show --password "$1" 2>/dev/null || true
    else
        gopass show "$1" "$2" 2>/dev/null || true
    fi
}

export CONFLUENCE_URL="$(gopass_get bitwarden/atlassian/confluence url)"
export CONFLUENCE_USERNAME="$(gopass_get bitwarden/atlassian/confluence username)"
export CONFLUENCE_API_TOKEN="$(gopass_get bitwarden/atlassian/confluence)"
export JIRA_URL="$(gopass_get bitwarden/atlassian/jira url)"
export JIRA_USERNAME="$(gopass_get bitwarden/atlassian/jira username)"
export JIRA_API_TOKEN="$(gopass_get bitwarden/atlassian/jira)"

exec mise exec -- mcp-atlassian "$@"

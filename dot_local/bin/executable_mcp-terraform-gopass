#!/usr/bin/env bash
set -euo pipefail

TFE_TOKEN="$(gopass show --password bitwarden/terraform/api-token)"
if [[ -z "${TFE_TOKEN}" ]]; then
    echo "mcp-terraform-gopass: empty secret (gopass age agent down? check: gopass age agent status)" >&2
    exit 1
fi
export TFE_TOKEN

exec mise exec -- terraform-mcp-server stdio "$@"

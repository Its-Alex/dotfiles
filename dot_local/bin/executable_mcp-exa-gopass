#!/usr/bin/env bash
set -euo pipefail

EXA_API_KEY="$(gopass show --password bitwarden/exa/api-key)"
if [[ -z "${EXA_API_KEY}" ]]; then
    echo "mcp-exa-gopass: empty secret (gopass age agent down? check: gopass age agent status)" >&2
    exit 1
fi
export EXA_API_KEY

exec mise exec -C "$HOME" -- exa-mcp-server "$@"

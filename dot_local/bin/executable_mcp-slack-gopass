#!/usr/bin/env bash
set -euo pipefail

export SLACK_MCP_XOXP_TOKEN="$(gopass show --password bitwarden/slack/xoxp)"
if [[ -z "${SLACK_MCP_XOXP_TOKEN}" ]]; then
    echo "mcp-slack-gopass: empty secret (gopass age agent down? check: gopass age agent status)" >&2
    exit 1
fi
export SLACK_MCP_ADD_MESSAGE_TOOL=true

# The boot sweep saturates Slack's per-method limit; make refreshes rare and bound any thrash.
export SLACK_MCP_CACHE_TTL=168h
export SLACK_MCP_MIN_REFRESH_INTERVAL=900s

exec mise exec -C "$HOME" -- slack-mcp-server --transport stdio "$@"

font-family = "FiraCode Nerd Font"
font-size = 9

theme = dracula

# io_uring waits are accounted as iowait and pollute PSI (ghostty-org/ghostty#3246)
async-backend = epoll

command = /usr/bin/tmux new-session -A -s main

# Keybindings (tmux handles splits/tabs)
keybind = super+d=unbind
keybind = super+shift+d=unbind
keybind = super+t=unbind
keybind = super+shift+t=unbind
keybind = super+shift+enter=unbind

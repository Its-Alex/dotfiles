{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "cc-safety-net@2.6.0",
    "@jonathanmorley/opencode-claude-compat@0.3.0"
  ],
  "update": "notify",
  "model": "openrouter/anthropic/claude-sonnet-5.5",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "websearch": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp"
      },
      "grep_app": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      }{{- if and (ne (env "CHEZMOI_PASSWORD_MANAGER_DISABLED") "true") (ne (env "CHEZMOI_PASSWORD_MANAGER_DISABLED") "1") }},
      "mcp-atlassian": {
        "type": "local",
        "command": [
          "{{ .chezmoi.homeDir }}/.local/bin/mcp-atlassian-keyring"
        ]
      },
      "linear": {
        "type": "local",
        "command": [
          "{{ .chezmoi.homeDir }}/.local/bin/mcp-remote-linear-keyring"
        ]
      }
{{- end }}
    }
  },
  "permissions": [
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "su", "effect": "deny" },
    { "action": "shell", "resource": "su *", "effect": "deny" },
    { "action": "shell", "resource": "doas *", "effect": "deny" },
    { "action": "shell", "resource": "pkexec *", "effect": "deny" },
    { "action": "shell", "resource": "visudo*", "effect": "deny" },
    { "action": "shell", "resource": "systemctl *", "effect": "deny" },
    { "action": "shell", "resource": "service *", "effect": "deny" },
    { "action": "shell", "resource": "mount *", "effect": "deny" },
    { "action": "shell", "resource": "umount *", "effect": "deny" },
    { "action": "shell", "resource": "useradd *", "effect": "deny" },
    { "action": "shell", "resource": "usermod *", "effect": "deny" },
    { "action": "shell", "resource": "userdel *", "effect": "deny" },
    { "action": "shell", "resource": "groupadd *", "effect": "deny" },
    { "action": "shell", "resource": "groupdel *", "effect": "deny" },
    { "action": "shell", "resource": "passwd*", "effect": "deny" },
    { "action": "shell", "resource": "iptables *", "effect": "deny" },
    { "action": "shell", "resource": "ip6tables *", "effect": "deny" },
    { "action": "shell", "resource": "ufw *", "effect": "deny" },
    { "action": "shell", "resource": "firewall-cmd *", "effect": "deny" },
    { "action": "shell", "resource": "apt *", "effect": "deny" },
    { "action": "shell", "resource": "apt-get *", "effect": "deny" },
    { "action": "shell", "resource": "yum *", "effect": "deny" },
    { "action": "shell", "resource": "dnf *", "effect": "deny" },
    { "action": "shell", "resource": "pacman *", "effect": "deny" },
    { "action": "shell", "resource": "modprobe *", "effect": "deny" },
    { "action": "shell", "resource": "insmod *", "effect": "deny" },
    { "action": "shell", "resource": "rmmod *", "effect": "deny" },
    { "action": "shell", "resource": "fdisk *", "effect": "deny" },
    { "action": "shell", "resource": "parted *", "effect": "deny" },
    { "action": "shell", "resource": "mkfs*", "effect": "deny" },
    { "action": "shell", "resource": "reboot*", "effect": "deny" },
    { "action": "shell", "resource": "shutdown*", "effect": "deny" },
    { "action": "shell", "resource": "poweroff*", "effect": "deny" },
    { "action": "shell", "resource": "halt*", "effect": "deny" },
    { "action": "shell", "resource": "nmcli *", "effect": "deny" },
    { "action": "shell", "resource": "timedatectl *", "effect": "deny" },
    { "action": "shell", "resource": "hostnamectl *", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "~/.ssh/*", "effect": "ask" },
    { "action": "edit", "resource": "~/.gnupg/*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" }
  ]
}

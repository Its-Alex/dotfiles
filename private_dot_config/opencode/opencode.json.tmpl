{{- if and (ne (env "CHEZMOI_PASSWORD_MANAGER_DISABLED") "true") (ne (env "CHEZMOI_PASSWORD_MANAGER_DISABLED") "1") }}
  "mcp": {
    "mcp-atlassian": {
      "type": "local",
      "enabled": true,
      "command": [
        "mise",
        "exec",
        "--",
        "mcp-atlassian"
      ],
      "environment": {
        "CONFLUENCE_URL": "{{ (bitwardenFields "item" "Confluence - API Token").space_url.value }}",
        "CONFLUENCE_USERNAME": "{{ (bitwarden "item" "Confluence - API Token").login.username }}",
        "CONFLUENCE_API_TOKEN": "{{ (bitwarden "item" "Confluence - API Token").login.password }}",
        "JIRA_URL": "{{ (bitwardenFields "item" "Jira - API Token ").space_url.value }}",
        "JIRA_USERNAME": "{{ (bitwarden "item" "Jira - API Token ").login.username }}",
        "JIRA_API_TOKEN": "{{ (bitwarden "item" "Jira - API Token ").login.password }}"
      }
    },
    "linear": {
      "type": "local",
      "enabled": true,
      "command": [
        "mise",
        "exec",
        "--",
        "mcp-remote",
        "https://mcp.linear.app/mcp",
        "--header",
        "Authorization:${LINEAR_AUTH_HEADER}"
      ],
      "environment": {
        "LINEAR_AUTH_HEADER": "Bearer {{ (bitwarden "item" "Linear - API Key").login.password }}"
      }
    }
  }
{{- end }},
  "permission": {
    "bash": {
      "sudo *": "deny",
      "su": "deny",
      "su *": "deny",
      "doas *": "deny",
      "pkexec *": "deny",
      "visudo*": "deny",
      "systemctl *": "deny",
      "service *": "deny",
      "mount *": "deny",
      "umount *": "deny",
      "useradd *": "deny",
      "usermod *": "deny",
      "userdel *": "deny",
      "groupadd *": "deny",
      "groupdel *": "deny",
      "passwd*": "deny",
      "iptables *": "deny",
      "ip6tables *": "deny",
      "ufw *": "deny",
      "firewall-cmd *": "deny",
      "apt *": "deny",
      "apt-get *": "deny",
      "yum *": "deny",
      "dnf *": "deny",
      "pacman *": "deny",
      "modprobe *": "deny",
      "insmod *": "deny",
      "rmmod *": "deny",
      "fdisk *": "deny",
      "parted *": "deny",
      "mkfs*": "deny",
      "reboot*": "deny",
      "shutdown*": "deny",
      "poweroff*": "deny",
      "halt*": "deny",
      "nmcli *": "deny",
      "timedatectl *": "deny",
      "hostnamectl *": "deny"
    }
  }
}

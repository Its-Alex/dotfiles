set-option -g default-shell /usr/bin/zsh

set -as terminal-overrides ",xterm-ghostty*:Tc,xterm-256color:Tc"
set-option -g default-terminal "tmux-256color"

set-option -g destroy-unattached off
set-option -g detach-on-destroy on

set-option -g mouse on
# Wheel-up dispatch: mouse mode, then alternate screen, then copy mode, else enter
# copy mode. Nested if-shells because tmux has no else-if.
bind -n WheelUpPane if-shell -Ft= "#{mouse_any_flag}" "send-keys -M" "if-shell -Ft= '#{alternate_on}' 'send-keys -t= up' 'if-shell -Ft= \"#{pane_in_mode}\" \"send-keys -M\" \"select-pane -t=; copy-mode -e; send-keys -M\"'"
bind -n WheelDownPane if-shell -Ft= "#{alternate_on}" "send-keys -t= down" "select-pane -t= \; send-keys -M"
bind -T copy-mode-vi WheelUpPane   select-pane \; send-keys -X -N 2 scroll-up
bind -T copy-mode-vi WheelDownPane select-pane \; send-keys -X -N 2 scroll-down

set-option -g prefix C-b
set-option -g status-keys vi
set-option -g mode-keys vi

set-option -sg escape-time 10

# Accept OSC 52 from applications and forward it out; the default "external"
# silently drops application-originated sequences, which breaks in-app copy.
set-option -g set-clipboard on
# OpenCode also wraps its OSC 52 in a DCS passthrough, dropped without this.
set-option -g allow-passthrough on

bind -T copy-mode-vi 'v' send -X begin-selection
if-shell -b 'test $(uname) = "Linux" && test -n "$WAYLAND_DISPLAY"' 'bind -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "wl-copy"'
if-shell -b 'test $(uname) = "Linux" && test -z "$WAYLAND_DISPLAY"' 'bind -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "xclip -in -selection clipboard"'
if-shell -b 'test $(uname) = "Darwin"' 'bind -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "pbcopy"'

set-option -g bell-action any
set-option -g activity-action other
set-option -g silence-action other
set-option -g visual-activity on
set-option -g visual-bell off
set-option -g visual-silence off

set-option -g word-separators " "

set-option -g focus-events on

set -ga terminal-features "*:hyperlinks"

bind-key u run-shell -b "flatpak run io.gitlab.librewolf-community \"$(tmux capture-pane -J -p | grep -oE '(https?):\/\/.*[^>]' | fzf-tmux -d20 --multi --bind alt-a:select-all,alt-d:deselect-all)\""

{{ if eq .chezmoi.os "linux" -}}
set-environment -g -F TMUX_PLUGIN_MANAGER_PATH "${HOME}/.config/tmux/plugins"
{{ end -}}
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'

set -g @plugin 'dracula/tmux'
set -g @dracula-show-left-icon session
set -g @dracula-plugins "cpu-usage ram-usage"
set -g @dracula-show-flags true
set -g @dracula-show-powerline false
set -g @dracula-border-contrast true

run '${HOME}/.config/tmux/plugins/tpm/tpm'

#!/usr/bin/env bash
set -euo pipefail

# Instance-scope keys only; profile settings live in preferences.json, which wins
# on read (the copy the app mirrors here is for older builds, unmanaged).
# privateRelay.enabled is read at start, relayUrl left as stored. Removed keys are
# ones no current build reads or writes. The mirrored profile copy is not listed:
# it is rewritten on every save.
removed_keys='["sidebarSessionGroupingMode"]'

managed_settings=$(cat <<'JSON'
{
  "openInAppId": "ghostty",
  "agentNotifyToolEnabled": true,
  "privateRelay": {
    "enabled": false
  }
}
JSON
)

current_settings=$(cat)
[ -n "${current_settings//[[:space:]]/}" ] || current_settings='{}'

jq --argjson managed "$managed_settings" --argjson removed "$removed_keys" \
  '(. * $managed) | delpaths($removed | map([.]))' <<<"$current_settings"

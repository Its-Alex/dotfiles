#!/usr/bin/env bash
set -euo pipefail

# Profile settings differing from the defaults. Per-surface keys are written only
# under surfaces.desktop, the base value other surfaces fall back to. updatedAt is
# left untouched so the app keeps its own timestamps authoritative.
managed_preferences=$(cat <<'JSON'
{
  "version": 1,
  "fields": {
    "favoriteModels": {
      "value": [
        {
          "providerID": "openrouter",
          "modelID": "anthropic/claude-sonnet-5.5"
        },
        {
          "providerID": "openrouter",
          "modelID": "anthropic/claude-opus-5.5"
        },
        {
          "providerID": "openrouter",
          "modelID": "anthropic/claude-fable-5"
        },
        {
          "providerID": "openrouter",
          "modelID": "anthropic/claude-sonnet-5"
        },
        {
          "providerID": "opencode-go",
          "modelID": "deepseek-v4.1-flash"
        }
      ]
    },
    "defaultModel": {
      "value": "opencode-go/deepseek-v4.1-flash"
    },
    "sidebarWorktreeSortOrder": {
      "value": "recent"
    },
    "expandReasoningWhileStreaming": {
      "value": true
    },
    "toolJsonViewMode": {
      "value": "raw"
    },
    "lightThemeId": {
      "surfaces": {
        "desktop": {
          "value": "dracula-light"
        }
      }
    },
    "darkThemeId": {
      "surfaces": {
        "desktop": {
          "value": "dracula-dark"
        }
      }
    }
  }
}
JSON
)

current_preferences=$(cat)
[ -n "${current_preferences//[[:space:]]/}" ] || current_preferences='{}'

# -j: the app writes these files with no trailing newline, and a jq-added one
# would show up in every chezmoi diff.
jq -j --argjson managed "$managed_preferences" '. * $managed' <<<"$current_preferences"

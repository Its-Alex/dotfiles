{{ if includeTemplate "bw-authenticated" . -}}
#!/usr/bin/env bash
set -euo pipefail

# gopass refuses a plaintext identity file, so the key goes through
# `gopass age identities add` (two positional args, hence non-interactive).
#
# Applies never prompt: the passphrase travels in GOPASS_AGE_PASSWORD. An
# interactive shell uses the keyring (age.usekeychain) plus the age agent, which
# is ~12 ms per read against ~575 ms when re-derived.
#
# Settings via `gopass config`, not a managed file: gopass rewrites its config
# itself, which would report drift on every apply.
gopass_bin="$(command -v gopass || true)"
if [ -z "$gopass_bin" ] && command -v mise > /dev/null; then
    printf "\e[1;34m%s\e[1;0m\n" "Install age and gopass through mise..."
    mise install age gopass > /dev/null 2>&1 || true
    gopass_bin="$(mise which gopass 2> /dev/null || true)"
fi

if [ -z "$gopass_bin" ]; then
    printf "\e[1;33m%s\e[1;0m\n" "gopass not found and not installable through mise; skipping gopass setup."
    exit 0
fi

printf "\e[1;34m%s\e[1;0m\n" "Configure gopass (age identity and global store)..."

# `with`, not `.value`: a missing field must not abort the apply.
age_identity="{{ with (index (bitwardenFields "item" "Age - gopass identity") "age-identity") }}{{ .value }}{{ end }}"
age_recipient="{{ with (index (bitwardenFields "item" "Age - gopass identity") "age-recipient") }}{{ .value }}{{ end }}"
age_keyring_pass="{{ with (index (bitwardenFields "item" "Age - gopass identity") "gopass-keyring-pass") }}{{ .value }}{{ end }}"

# Export nothing when absent, so gopass falls back to the OS keyring.
if [ -n "$age_keyring_pass" ]; then
    export GOPASS_AGE_PASSWORD="$age_keyring_pass"
fi

# Without this guard an empty recipient makes the grep below match anything.
if [ -z "$age_identity" ] || [ -z "$age_recipient" ]; then
    printf "\e[1;31m%s\e[1;0m\n" "Bitwarden item \"Age - gopass identity\" is missing the age-identity or age-recipient field."
    exit 1
fi

if "$gopass_bin" age identities 2> /dev/null | grep -qF "$age_recipient"; then
    printf "\e[1;32m%s\e[1;0m\n" "age identity already installed."
else
    "$gopass_bin" age identities add "$age_identity" "$age_recipient"
    printf "\e[1;32m%s\e[1;0m\n" "age identity installed."
fi

# The keyring caches the passphrase across commands; without one gopass warns on
# every call, so only ask for it when org.freedesktop.secrets is reachable.
if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && busctl --user --quiet status org.freedesktop.secrets > /dev/null 2>&1; then
    "$gopass_bin" config age.usekeychain true > /dev/null
else
    "$gopass_bin" config age.usekeychain false > /dev/null
fi
"$gopass_bin" config age.agent-enabled true > /dev/null

# The global store, backed by the private password-store repo. A repo-scoped
# store overrides mounts.path with GOPASS_CONFIG_KEY_0/_VALUE_0 instead.
store_path="${XDG_DATA_HOME:-$HOME/.local/share}/gopass/stores/root"
store_remote="git@github.com:Its-Alex/password-store.git"

# gopass may commit its own setup while preparing the store, and gpgsign=true then
# needs the passphrase: a machine that has never applied has no keyring to supply
# it, so those bookkeeping commits stay unsigned. Interactive commits still sign.
export GIT_CONFIG_COUNT=1
export GIT_CONFIG_KEY_0=commit.gpgsign
export GIT_CONFIG_VALUE_0=false

# mounts.path creates the directory, so a directory proves nothing: the recipients
# file the clone brings is what marks an initialized store.
if [ ! -f "$store_path/.age-recipients" ] && [ ! -f "$store_path/.gpg-id" ]; then
    if [ -d "$store_path" ] && [ -z "$(ls -A "$store_path")" ]; then
        rmdir "$store_path"
    fi
    store_was_absent=false
    if [ ! -e "$store_path" ]; then
        store_was_absent=true
    fi
    # BatchMode keeps an unattended apply from hanging on SSH.
    export GIT_TERMINAL_PROMPT=0
    export GIT_SSH_COMMAND='ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new'

    # No agent holds the key on a fresh machine: load it into a throwaway agent with
    # the passphrase from Bitwarden, for this clone only. The askpass helper reads
    # the passphrase from its environment, so it never reaches the disk.
    ssh_key="$HOME/.ssh/itsalex"
    ssh_key_passphrase="$(printf '%s' "{{ dig "login" "password" "" (bitwarden "item" "cc6b586b-67e2-47de-b512-b2a300fa609d") | b64enc }}" | base64 -d)"
    if ! git ls-remote --heads "$store_remote" > /dev/null 2>&1 \
        && [ -f "$ssh_key" ] && [ -n "$ssh_key_passphrase" ]; then
        askpass_dir="$(mktemp -d)"
        eval "$(ssh-agent -s)" > /dev/null
        trap 'ssh-agent -k > /dev/null 2>&1; rm -rf -- "$askpass_dir"' EXIT
        # ssh-add re-asks after a wrong passphrase until an answer fails: answer once.
        cat > "$askpass_dir/askpass" << 'ASKPASS'
#!/bin/sh
[ -e "$0.used" ] && exit 1
: > "$0.used"
printf '%s\n' "$SSH_KEY_PASSPHRASE"
ASKPASS
        chmod 700 "$askpass_dir/askpass"
        if ! SSH_KEY_PASSPHRASE="$ssh_key_passphrase" SSH_ASKPASS="$askpass_dir/askpass" SSH_ASKPASS_REQUIRE=force \
            ssh-add "$ssh_key" < /dev/null > /dev/null 2>&1; then
            printf "\e[1;33m%s\e[1;0m\n" "The Bitwarden passphrase did not unlock ${ssh_key}."
        fi
    fi
    unset ssh_key_passphrase

    # The store is published once and shared by every machine: clone it or fail.
    # Creating one here would fork it with unrelated history. A non-zero exit also
    # keeps chezmoi from recording this run_onchange_ script as done, so the next
    # apply retries the clone. gopass only stops asking for the git name and email
    # (defaults: the deployed git config) when stdin is not a character device, so
    # a pipe, not /dev/null.
    printf "\e[1;34m%s\e[1;0m\n" "Clone the global password store from ${store_remote}..."
    if ! : | "$gopass_bin" clone --crypto age --path "$store_path" "$store_remote"; then
        # Only this failed clone created the directory: a leftover would block the retry.
        if [ "$store_was_absent" = true ]; then
            rm -rf -- "$store_path"
        fi
        printf "\e[1;31m%s\e[1;0m\n" "Cannot clone ${store_remote}. Check the network and that ${ssh_key} is unlocked by its Bitwarden item's password (or load it with ssh-add), then re-run chezmoi apply."
        exit 1
    fi
    unset GIT_TERMINAL_PROMPT GIT_SSH_COMMAND
fi

# After the store exists: mounts.path on its own just creates the directory.
"$gopass_bin" config mounts.path "$store_path" > /dev/null

# The Bitwarden mirror is a separate, git-less mount: Bitwarden is the source and
# the seed script rebuilds it, so pushing would only expose work credentials.
mirror_name="bitwarden"
mirror_path="${XDG_DATA_HOME:-$HOME/.local/share}/gopass/stores/${mirror_name}"
if [ ! -d "$store_path" ]; then
    printf "\e[1;33m%s\e[1;0m\n" "Global store missing; skipping the ${mirror_name} mount."
elif ! "$gopass_bin" --nosync mounts 2> /dev/null | grep -qF "${mirror_name} ("; then
    if [ -d "$mirror_path" ]; then
        "$gopass_bin" mounts add "$mirror_name" "$mirror_path"
    else
        printf "\e[1;34m%s\e[1;0m\n" "Create the local ${mirror_name} mount..."
        "$gopass_bin" init --crypto age --storage fs --store "$mirror_name" --path "$mirror_path" "$age_recipient"
    fi
fi

printf "\e[1;32m%s\e[1;0m\n" "gopass configured."
{{ else -}}
#!/usr/bin/env bash
set -euo pipefail

printf "\e[1;33m%s\e[1;0m\n" "No Bitwarden session; skipping gopass setup. Run: bw login && chezmoi apply"
exit 0
{{ end -}}

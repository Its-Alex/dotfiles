#!/usr/bin/env bash
set -euo pipefail

# mise config hash: {{ include "private_dot_config/mise/config.toml" | sha256sum }}

if ! command -v mise > /dev/null; then
    printf "\e[1;33m%s\e[1;0m\n" "mise not installed; skipping the tool install."
    exit 0
fi

# Interactive shells resolve every tool in the config on each prompt, so a fresh
# machine pays network timeouts per shell until these exist.
printf "\e[1;34m%s\e[1;0m\n" "Install mise tools..."
if ! mise install; then
    printf "\e[1;33m%s\e[1;0m\n" "mise install failed; every new shell keeps resolving the tool list. Run 'mise install' once the network is back."
fi

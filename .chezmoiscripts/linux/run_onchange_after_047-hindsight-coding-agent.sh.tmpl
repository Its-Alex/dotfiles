{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

if ! command -v opencode > /dev/null; then
    exit 0
fi

printf "\e[1;34m%s\e[1;0m\n" "Configure Hindsight coding-agent memory..."

config_dir="{{ .chezmoi.homeDir }}/.hindsight"
config="$config_dir/coding-agent.json"

if ! command -v rbw > /dev/null; then
    printf "\e[1;33m%s\e[1;0m\n" "Hindsight: rbw not found; leaving the stored config untouched."
    exit 0
fi

# Bitwarden holds the key; chezmoi reaches it through rbw, as the other
# Bitwarden-sourced secrets do. Addressed by item id: the vault already holds
# duplicate names, and an id survives a rename.
api_token="$(rbw get 0ccb98b6-8be4-43e9-87e6-b4ff00e77072 2> /dev/null || true)"
if [ -z "$api_token" ]; then
    printf "\e[1;33m%s\e[1;0m\n" "Hindsight: rbw cannot read Bitwarden item 0ccb98b6-8be4-43e9-87e6-b4ff00e77072 (deleted or recreated? run rbw sync); leaving the stored config untouched."
    exit 0
fi

umask 077
mkdir -p "$config_dir"
tmp="$(mktemp "$config.XXXXXX")"

jq -n --arg apiToken "$api_token" '{
  apiUrl: "https://hindsight-api.int.itsalex.fr",
  apiToken: $apiToken,
  optInOnly: false,
  retainExtractionMode: "concise",
  gitIngest: "message"
}' > "$tmp"

mv "$tmp" "$config"
chmod 600 "$config"

# `update` re-stages the runtime in place and, unlike `install`, leaves
# opencode.json alone, which chezmoi owns.
mise exec -- npx -y @vectorize-io/hindsight-coding-agents@latest update

{{ end -}}

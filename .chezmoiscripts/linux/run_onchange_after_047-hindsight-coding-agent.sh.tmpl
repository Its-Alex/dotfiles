{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

if ! command -v opencode > /dev/null; then
    exit 0
fi

printf "\e[1;34m%s\e[1;0m\n" "Configure Hindsight coding-agent memory..."

config_dir="{{ .chezmoi.homeDir }}/.hindsight"
config="$config_dir/coding-agent.json"

if ! command -v rbw > /dev/null; then
    printf "\e[1;33m%s\e[1;0m\n" "Hindsight: rbw not found; leaving the stored config untouched."
    exit 0
fi

# Renders "yes" only once Bitwarden is logged in, and changes the script hash when
# that flips, so a skip recorded before `rbw login` is retried after it.
bitwarden_logged_in={{ if includeTemplate "rbw-authenticated" . }}yes{{ else }}no{{ end }}
if [ "$bitwarden_logged_in" != yes ]; then
    printf "\e[1;33m%s\e[1;0m\n" "Hindsight: Bitwarden not logged in; retried after rbw login."
    exit 0
fi

# Bitwarden holds the key; chezmoi reaches it through rbw, as the other
# Bitwarden-sourced secrets do. Addressed by item id: the vault already holds
# duplicate names, and an id survives a rename.
#
# A failed read exits non-zero on purpose: chezmoi only records a script as run
# when it exits 0, so a locked vault or an unsynced item stays unrecorded and the
# next apply retries instead of skipping Hindsight for good.
if ! api_token="$(rbw get 0ccb98b6-8be4-43e9-87e6-b4ff00e77072 2> /dev/null)" || [ -z "$api_token" ]; then
    printf "\e[1;31m%s\e[1;0m\n" "Hindsight: cannot read Bitwarden item 0ccb98b6-8be4-43e9-87e6-b4ff00e77072 (locked vault? run rbw unlock; item gone? run rbw sync)." >&2
    exit 1
fi

umask 077
mkdir -p "$config_dir"
tmp="$(mktemp "$config.XXXXXX")"

# This file tells the plugin where to read and write, nothing else: the bank's
# own configuration (missions, extraction strategies, knowledge pages) is owned by
# the deployment that runs the server, and is applied from there.
#
# autoSeed stays off so no session ever spawns the deepening engine; gitIngest and
# codebaseSurvey stay pinned anyway, as the guards that keep a stray deepen run on
# this machine from importing its history into the shared bank.
jq -n --arg apiToken "$api_token" '{
  apiUrl: "https://hindsight-api.int.itsalex.fr",
  apiToken: $apiToken,
  bankId: "user::alex",
  autoSeed: false,
  codebaseSurvey: false,
  gitIngest: "none",
  retainTags: ["repo:{gitProject}"],
  retainContext: (
    "conversation between the user and you (the coding agent), held in the repository {gitProject}: "
    + "user turns are the words and decisions of the user, assistant turns are yours. When an assistant "
    + "turn says something is fixed, passes or works, record it as a claim made by the agent (\"the agent "
    + "reported X fixed\"), not as an established fact. Record every preference, correction and "
    + "standing instruction the user gives about how they want work done as a durable fact of its "
    + "own, with exact values verbatim, and name {gitProject} when it applies to that repository only."
  ),
  toolGuideExtra: (
    "This bank is the personal memory of the user, shared by every repository and machine. The page "
    + "\"Preferences and standing decisions\" holds how the user wants work done: read it with "
    + "hindsight_read_page before making a choice it could cover. A preference stated in the "
    + "current conversation is newer than the page and wins."
  )
}' > "$tmp"

mv "$tmp" "$config"
chmod 600 "$config"

# `update` re-stages the runtime in place and, unlike `install`, leaves
# opencode.json alone, which chezmoi owns.
mise exec -- npx -y @vectorize-io/hindsight-coding-agents@latest update

{{ end -}}

{{ if and (eq .chezmoi.os "linux") (ne (env "CHEZMOI_PASSWORD_MANAGER_DISABLED") "true") (ne (env "CHEZMOI_PASSWORD_MANAGER_DISABLED") "1") -}}
#!/usr/bin/env bash
set -euo pipefail

if ! command -v claude > /dev/null; then
    exit 0
fi

printf "\e[1;34m%s\e[1;0m\n" "Configure Claude Code MCP servers (user scope)..."

# The dot_local/bin MCP wrappers read credentials from gopass at start-up, so
# Claude Code never persists a token into ~/.claude.json.
claude mcp remove mcp-atlassian --scope user 2>&1 || true
claude mcp add --scope user \
    --transport stdio \
    mcp-atlassian -- mcp-atlassian-gopass

claude mcp remove linear --scope user 2>&1 || true
claude mcp add --scope user \
    --transport stdio \
    linear -- mcp-remote-linear-gopass

claude mcp remove terraform --scope user 2>&1 || true
claude mcp add --scope user \
    --transport stdio \
    terraform -- mcp-terraform-gopass

# Remote MCP server: authenticates through its own OAuth flow, so no wrapper.
claude mcp remove granola --scope user 2>&1 || true
claude mcp add --scope user \
    --transport http \
    granola https://mcp.granola.ai/mcp

printf "\e[1;34m%s\e[1;0m\n" "Install CC Safety Net for Claude Code..."

mise exec -- npx -y cc-safety-net@latest install --claude-code

{{ end -}}

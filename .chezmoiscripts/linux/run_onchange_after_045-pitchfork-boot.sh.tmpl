{{ if and (eq .chezmoi.osRelease.id "arch") (eq .role "headless") -}}
#!/usr/bin/env bash
set -euo pipefail

# Neither a chezmoi apply nor a boot service activates the shell, so mise's
# shims are not on PATH here.
pitchfork_bin="$(command -v pitchfork || mise which pitchfork 2> /dev/null || true)"
if [ -z "$pitchfork_bin" ]; then
    printf "\e[1;33m%s\e[1;0m\n" "pitchfork not installed; skipping the boot registration."
    exit 0
fi

{{ includeTemplate "user-bus" . }}

printf "\e[1;34m%s\e[1;0m\n" "Register the pitchfork supervisor at boot..."
"$pitchfork_bin" boot enable
"$pitchfork_bin" boot status
{{ end -}}

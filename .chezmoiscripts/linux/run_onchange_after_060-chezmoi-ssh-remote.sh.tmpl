{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

# The key is only deployed after `bw login && chezmoi apply`: this line changes
# then, so the skip recorded by a secretless apply is retried.
# bitwarden session: {{ if includeTemplate "bw-authenticated" . }}yes{{ else }}no{{ end }}
repo="${HOME}/.local/share/chezmoi"
key="${HOME}/.ssh/itsalex"
remote="git@github.com:Its-Alex/dotfiles.git"

if [ ! -s "$key" ]; then
    printf "\e[1;33m%s\e[1;0m\n" "~/.ssh/itsalex is not deployed; skipping the origin switch. Run: bw login && chezmoi apply"
    exit 0
fi

current="$(git -C "$repo" remote get-url origin 2> /dev/null || true)"
if [ -z "$current" ] || [ "$current" = "$remote" ]; then
    exit 0
fi

git -C "$repo" remote set-url origin "$remote"
printf "\e[1;32m%s\e[1;0m\n" "chezmoi origin switched to ${remote}"
{{ end -}}

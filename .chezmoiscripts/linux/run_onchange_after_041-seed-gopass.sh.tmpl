{{ if includeTemplate "rbw-authenticated" . -}}
#!/usr/bin/env bash
set -euo pipefail

# Copy the Bitwarden items the dotfiles consume into the `bitwarden` mount.
# Bitwarden is the source of truth: edits in gopass are overwritten here.
gopass_bin="$(command -v gopass || true)"
if [ -z "$gopass_bin" ] && command -v mise > /dev/null; then
    gopass_bin="$(mise which gopass 2> /dev/null || true)"
fi
if [ -z "$gopass_bin" ]; then
    printf "\e[1;33m%s\e[1;0m\n" "gopass not found; skipping store seeding."
    exit 0
fi

# Passphrase from Bitwarden, as in setup-gopass, so seeding never prompts.
age_keyring_pass="{{ with (index (rbwFields "Age - gopass identity") "gopass-keyring-pass") }}{{ .value }}{{ end }}"

# Export nothing when absent, so gopass falls back to the OS keyring.
if [ -n "$age_keyring_pass" ]; then
    export GOPASS_AGE_PASSWORD="$age_keyring_pass"
fi

mirror_name="bitwarden"

# Without the mount, `bitwarden/...` is a plain folder of the git-backed store.
if ! "$gopass_bin" --nosync mounts 2> /dev/null | grep -qF "${mirror_name} ("; then
    printf "\e[1;33m%s\e[1;0m\n" "gopass mount \"${mirror_name}\" missing; skipping store seeding."
    exit 0
fi

printf "\e[1;34m%s\e[1;0m\n" "Seed the ${mirror_name} gopass mount from Bitwarden..."

# seed_mirror_entry <entry> <password> [<key> <value>]…: password first line,
# then `key: value` lines. An empty value (a renamed or mistyped Bitwarden item)
# is refused rather than clobbering the stored entry; unchanged entries are left.
seed_mirror_entry() {
    local entry="${mirror_name}/$1" password="$2" content current
    shift 2
    if [ -z "$password" ]; then
        printf "\e[1;33m%s\e[1;0m\n" "Bitwarden password for ${entry} is empty; leaving the stored entry untouched."
        return 0
    fi
    content="$password"
    while [ "$#" -ge 2 ]; do
        if [ -z "$2" ]; then
            printf "\e[1;33m%s\e[1;0m\n" "Bitwarden field \"$1\" for ${entry} is empty; leaving the stored entry untouched."
            return 0
        fi
        content="${content}"$'\n'"$1: $2"
        shift 2
    done
    current="$("$gopass_bin" --nosync show --unsafe --noparsing "$entry" 2> /dev/null || true)"
    [ "$current" = "$content" ] && return 0
    printf '%s' "$content" | "$gopass_bin" --nosync insert --force "$entry"
}

seed_mirror_entry gitlab/api-token "{{ (rbw "Gitlab - API Token").data.password }}"
seed_mirror_entry linear/api-key "{{ (rbw "Linear - API Key").data.password }}"
seed_mirror_entry terraform/api-token "{{ (rbw "Terraform - API Token").data.password }}"
seed_mirror_entry atlassian/confluence "{{ (rbw "Confluence - API Token").data.password }}" \
    url "{{ (rbwFields "Confluence - API Token").space_url.value }}" \
    username "{{ (rbw "Confluence - API Token").data.username }}"
seed_mirror_entry atlassian/jira "{{ (rbw "Jira - API Token").data.password }}" \
    url "{{ (rbwFields "Jira - API Token").space_url.value }}" \
    username "{{ (rbw "Jira - API Token").data.username }}"
seed_mirror_entry slack/xoxc-xoxd "{{ (rbwFields "Slack - XOXC/XOXD").SLACK_MCP_XOXC_TOKEN.value }}" \
    xoxd "{{ (rbwFields "Slack - XOXC/XOXD").SLACK_MCP_XOXD_TOKEN.value }}"

printf "\e[1;32m%s\e[1;0m\n" "${mirror_name} gopass mount seeded."
{{ end -}}

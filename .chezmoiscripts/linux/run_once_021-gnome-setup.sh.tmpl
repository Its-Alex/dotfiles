{{ if and (eq .chezmoi.os "linux") (eq .role "desktop") -}}
#!/usr/bin/env bash
set -euo pipefail

if [[ -d /boot/grub/ ]]; then
    printf "\e[1;34m%s\e[1;0m\n" "Grub update to detect others systems"
    sudo sed -i '/^#\?GRUB_DISABLE_OS_PROBER=/c\GRUB_DISABLE_OS_PROBER=false' /etc/default/grub
    sudo grub-mkconfig -o /boot/grub/grub.cfg
fi

if [[ -f /etc/bluetooth/main.conf ]]; then
    printf "\e[1;34m%s\e[1;0m\n" "Disable Bluetooth auto-enable on boot"
    if grep -q '^#\?AutoEnable=' /etc/bluetooth/main.conf; then
        sudo sed -i '/^#\?AutoEnable=/c\AutoEnable=false' /etc/bluetooth/main.conf
    else
        printf '\n[Policy]\nAutoEnable=false\n' | sudo tee -a /etc/bluetooth/main.conf > /dev/null
    fi
fi

if [[ ! -d "/usr/share/icons/Twilight-cursors" ]]; then
    printf "\e[1;34m%s\e[1;0m\n" "Setup Twilight cursors"
    rm -rf /tmp/Twilight-Cursors
    # Fork with SVG cursors until yeyushengfan258/Twilight-Cursors#2 merges
    git clone --branch gnome-51-svg-cursors git@github.com:Its-Alex/Twilight-Cursors.git /tmp/Twilight-Cursors
    (
        cd  /tmp/Twilight-Cursors
        sudo ./install.sh
    )
    rm -rf /tmp/Twilight-Cursors
fi

printf "\e[1;34m%s\e[1;0m\n" "Installing extensions…"
if [[ -f "{{ .chezmoi.sourceDir }}/gnome-extensions.txt" ]]; then
    # --filesystem avoids gext's DBus dialog, which an unattended apply cannot answer.
    mapfile -t gnome_extension_uuids < <(grep -v '^[[:space:]]*$' "{{ .chezmoi.sourceDir }}/gnome-extensions.txt")
    gext --filesystem install "${gnome_extension_uuids[@]}" || printf "\e[1;31m%s\e[1;0m\n" "gext failed to install some extensions."
else
    printf "\e[1;31m%s\e[1;0m\n" "Missing file: {{ .chezmoi.sourceDir }}/gnome-extensions.txt"
fi
printf "\e[1;34m%s\e[1;0m\n" "Restoring settings…"
if [[ -f "{{ .chezmoi.sourceDir }}/gnome-shell-extensions.dconf" ]]; then
    dconf load /org/gnome/shell/extensions/ < "{{ .chezmoi.sourceDir }}/gnome-shell-extensions.dconf" || true
else
    printf "\e[1;31m%s\e[1;0m\n" "Missing file: {{ .chezmoi.sourceDir }}/gnome-shell-extensions.dconf (no settings restored)"
fi
printf "\e[1;34m%s\e[1;0m\n" "Reboot your computer to enable new gnome shell extensions!"

if command -v gsettings > /dev/null; then
    printf "\e[1;34m%s\e[1;0m\n" "Setup Gnome settings"

    gsettings set org.gnome.desktop.background picture-uri "file://${HOME}/Pictures/space_bg.jpg"
    gsettings set org.gnome.desktop.background picture-uri-dark "file://${HOME}/Pictures/space_bg.jpg"
    gsettings set org.gnome.desktop.input-sources sources "[('xkb', 'us+qwerty-fr')]"
    gsettings set org.gnome.desktop.break-reminders selected-breaks "[]"
    gsettings set org.gnome.desktop.peripherals.touchpad natural-scroll false
    gsettings set org.gnome.settings-daemon.plugins.color night-light-enabled true
    # Enable location services (sunrise/sunset for Night Theme Switcher)
    gsettings set org.gnome.system.location enabled true
    gsettings set org.gnome.desktop.interface enable-hot-corners false
    gsettings set org.gnome.desktop.interface gtk-theme "Numix-Frost"
    gsettings set org.gnome.desktop.interface icon-theme Numix-Square
    gsettings set org.gnome.desktop.interface cursor-theme "Twilight-cursors"
fi
{{ end -}}

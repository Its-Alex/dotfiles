{{ if includeTemplate "rbw-authenticated" . -}}
#!/usr/bin/env bash
set -euo pipefail

# GPG signs commits (git, jj): import the keys and cache their passphrases in the
# keyring, or every commit blocks on a pinentry prompt.
if ! command -v gpg > /dev/null; then
    printf "\e[1;33m%s\e[1;0m\n" "gpg not found (install gnupg); skipping GPG setup."
    exit 0
fi

printf "\e[1;34m%s\e[1;0m\n" "Import GPG secret keys from Bitwarden..."
# --batch: gpg-agent would otherwise prompt to re-encrypt, which fails on stdin.
# Personal
echo "{{ includeTemplate "bitwarden-file" (dict "note" "GPG - private key") }}" | gpg --batch --import -
# Relex work
echo "{{ includeTemplate "bitwarden-file" (dict "note" "GPG - Relex - private key") }}" | gpg --batch --import -

if ! command -v secret-tool > /dev/null; then
    printf "\e[1;33m%s\e[1;0m\n" "secret-tool not found (install libsecret); skipping GPG passphrase seeding."
    exit 0
fi

# secret-tool talks to org.freedesktop.secrets over the session bus, which a
# container or a VM with no login session does not have.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] || ! busctl --user --quiet status org.freedesktop.secrets > /dev/null 2>&1; then
    printf "\e[1;33m%s\e[1;0m\n" "No session keyring (headless); skipping GPG passphrase seeding."
    exit 0
fi

printf "\e[1;34m%s\e[1;0m\n" "Seed GPG passphrases into the keyring..."

# pinentry looks up keygrip "n/<keygrip>" under org.gnupg.Passphrase; keygrips are
# read back from the imported keys, covering primary and subkey.
seed_gpg_passphrase() {
    local item="$2" key="$3" keygrip
    local passphrase
    # base64: a raw "$" or backtick in the passphrase would be expanded by the shell.
    passphrase="$(printf '%s' "$1" | base64 -d)"
    if [ -z "$passphrase" ]; then
        printf "\e[1;33m%s\e[1;0m\n" "No password on Bitwarden item \"$item\"; skipping its GPG passphrase."
        return 0
    fi
    while IFS= read -r keygrip; do
        if ! printf '%s' "$passphrase" | secret-tool store --label="GnuPG: n/$keygrip" \
            xdg:schema org.gnupg.Passphrase \
            stored-by "GnuPG Pinentry" \
            keygrip "n/$keygrip"; then
            printf "\e[1;33m%s\e[1;0m\n" "secret-tool refused the keyring; skipping GPG passphrase seeding."
            return 0
        fi
    done < <(gpg --with-colons --with-keygrip --list-secret-keys "$key" 2> /dev/null | awk -F: '/^grp:/ { print $10 }')
}

seed_gpg_passphrase \
    "{{ dig "data" "password" "" (rbw "e1ac83ba-e272-4b58-90eb-ae4c009cf0f7") | b64enc }}" \
    "GPG" \
    D13067073B9A98A9

seed_gpg_passphrase \
    "{{ dig "data" "password" "" (rbw "e10d8cc9-6527-49ab-b1b9-b4d301314972") | b64enc }}" \
    "GPG - Relex" \
    974BFB075A70590F

printf "\e[1;32m%s\e[1;0m\n" "GPG configured."
{{ end -}}

{{ if eq .chezmoi.osRelease.id "arch" -}}
#!/usr/bin/env bash
set -euo pipefail

# Enable pacman color
sudo sed -i '/^#Color/c\Color' /etc/pacman.conf

printf "\e[1;34m%s\e[1;0m\n" "Install Git..."
sudo pacman -S --noconfirm --needed git git-lfs base-devel

if ! command -v yay > /dev/null; then
    printf "\e[1;34m%s\e[1;0m\n" "Install Yay..."
    git clone https://aur.archlinux.org/yay.git /tmp/yay
    (
        cd /tmp/yay || exit 1
        makepkg -si --noconfirm --needed
    )
    rm -rf /tmp/yay
fi

printf "\e[1;34m%s\e[1;0m\n" "Install system programs.."
packages_list=(
{{- range .packages.arch.core }}
    {{ . }}
{{- end }}
{{- if eq .role "desktop" }}
{{-   range concat .packages.arch.desktop .packages.arch.oom .packages.arch.host .packages.arch.containers .packages.arch.virt }}
    {{ . }}
{{-   end }}
{{- else }}
{{-   $inContainer := ne (trim (output "sh" "-c" "systemd-detect-virt --container 2>/dev/null || true")) "none" }}
{{-   $groups := .packages.arch.containers }}
{{-   if not $inContainer }}
{{-     $groups = concat $groups .packages.arch.virt .packages.arch.oom }}
{{-   end }}
{{-   range $groups }}
    {{ . }}
{{-   end }}
{{- end }}
)
yay -S --noconfirm --needed "${packages_list[@]}"

# Since rtk 0.52.0, --opencode also sets up Claude Code (rtk-ai/rtk#3463).
rtk init -g --opencode --auto-patch
{{ end -}}

.envrc
AGENTS.md
README.md
archlinux-gnome-install.sh
mise.toml
scripts/
docs/
incus/
gnome-extensions.txt
gnome-shell-extensions.dconf

# Rewritten by their own tool on every run, so they drift between machines and
# trigger chezmoi's "changed since chezmoi wrote it" warnings. Not managed.
.cc-safety-net/rules/rule.lock
.config/mise/mise.lock
.config/nvim/lazy-lock.json
.config/opencode/tui.json

{{- if eq .role "desktop" }}
# pitchfork supervises user agents on the headless instance only; the desktop
# uses gcr and the GNOME keyring.
.config/pitchfork
{{- end }}

{{- if ne .role "desktop" }}
# GUI payloads: nothing here has a consumer without a graphical session.
.config/ghostty
.config/Claude
Pictures
.var
# Rootless podman inside an Incus container fails with its btrfs driver forced.
.config/containers/storage.conf.d
# pitchfork supervises the age agent on the instance; the unit is desktop-only.
.config/systemd/user/gopass-age-agent.service
{{- end }}

{{ if not (includeTemplate "rbw-authenticated" .) }}
# These render empty without a Bitwarden session. Ignored, the deployed keys
# stay as they are instead of being emptied as drift.
.ssh/itsalex
.ssh/itsalex-old
.ssh/itsalex.pub
.ssh/itsalex-old.pub
.ssh/relex
.ssh/relex.pub
{{ end }}

// OMO configuration
//
// 2026-09: opencode-go subscription hit its usage cap. Policy flip:
// - PRIMARY: always an Anthropic model (openrouter/anthropic/*) — no quota risk.
// - FALLBACK: only cheap/flash-tier opencode-go models (deepseek-*-flash,
//   glm-5.3-flash, qwen3.8-flash, mimo-v2.5) — kept purely as a safety net if
//   Anthropic itself is rate-limited or down, at minimal cost.
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "agents": {
      "sisyphus": {
        "model": "openrouter/anthropic/claude-sonnet-5",
        "reasoning": "medium",
        "fallback_models": [
          {
            "model": "opencode-go/deepseek-v4.1-flash"
          },
          {
            "model": "opencode-go/glm-5.3-flash"
          }
        ]
      },
      "hephaestus": {
        "model": "openrouter/anthropic/claude-sonnet-5",
        "reasoning": "high",
        "fallback_models": [
          {
            "model": "opencode-go/deepseek-v4.1-flash"
          },
          {
            "model": "opencode-go/glm-5.3-flash"
          }
        ]
      },
      "oracle": {
        "model": "openrouter/anthropic/claude-opus-5",
        "reasoning": "xhigh",
        "fallback_models": [
          {
            "model": "opencode-go/deepseek-v4.1-flash"
          },
          {
            "model": "opencode-go/glm-5.3-flash"
          }
        ]
      },
      "librarian": {
        "model": "openrouter/anthropic/claude-sonnet-5",
        "reasoning": "medium",
        "fallback_models": [
          {
            "model": "opencode-go/glm-5.3-flash"
          },
          {
            "model": "opencode-go/qwen3.8-flash"
          }
        ]
      },
      "explore": {
        "model": "openrouter/anthropic/claude-haiku-4.5",
        "fallback_models": [
          {
            "model": "opencode-go/glm-5.3-flash"
          },
          {
            "model": "opencode-go/mimo-v2.5"
          }
        ]
      },
      "multimodal-looker": {
        "model": "openrouter/anthropic/claude-sonnet-5",
        "reasoning": "medium",
        "fallback_models": [
          {
            "model": "opencode-go/glm-5.3-flash"
          },
          {
            "model": "opencode-go/qwen3.8-flash"
          }
        ]
      },
      "prometheus": {
        "model": "openrouter/anthropic/claude-sonnet-5",
        "reasoning": "medium",
        "fallback_models": [
          {
            "model": "opencode-go/deepseek-v4.1-flash"
          },
          {
            "model": "opencode-go/glm-5.3-flash"
          }
        ]
      },
      "metis": {
        "model": "openrouter/anthropic/claude-sonnet-5",
        "reasoning": "medium",
        "fallback_models": [
          {
            "model": "opencode-go/deepseek-v4.1-flash"
          },
          {
            "model": "opencode-go/glm-5.3-flash"
          }
        ]
      },
      "momus": {
        "model": "openrouter/anthropic/claude-sonnet-5",
        "reasoning": "medium",
        "fallback_models": [
          {
            "model": "opencode-go/deepseek-v4.1-flash"
          },
          {
            "model": "opencode-go/glm-5.3-flash"
          }
        ]
      },
      "atlas": {
        "model": "openrouter/anthropic/claude-sonnet-5",
        "reasoning": "medium",
        "fallback_models": [
          {
            "model": "opencode-go/deepseek-v4.1-flash"
          },
          {
            "model": "opencode-go/qwen3.8-flash"
          }
        ]
      },
      "sisyphus-junior": {
        "model": "openrouter/anthropic/claude-haiku-4.5",
        "fallback_models": [
          {
            "model": "opencode-go/glm-5.3-flash"
          },
          {
            "model": "opencode-go/qwen3.8-flash"
          }
        ]
      }
    },
    "categories": {
      "visual-engineering": {
        "models": [
          {
            "model": "openrouter/anthropic/claude-sonnet-5",
            "reasoning": "medium"
          },
          {
            "model": "opencode-go/glm-5.3-flash"
          },
          {
            "model": "opencode-go/qwen3.8-flash"
          }
        ]
      },
      "ultrabrain": {
        "models": [
          {
            "model": "openrouter/anthropic/claude-opus-5",
            "reasoning": "xhigh"
          },
          {
            "model": "opencode-go/deepseek-v4.1-flash"
          },
          {
            "model": "opencode-go/glm-5.3-flash"
          }
        ]
      },
      "deep-low": {
        "models": [
          {
            "model": "openrouter/anthropic/claude-sonnet-5",
            "reasoning": "xhigh"
          },
          {
            "model": "opencode-go/deepseek-v4.1-flash"
          },
          {
            "model": "opencode-go/glm-5.3-flash"
          }
        ]
      },
      "artistry": {
        "models": [
          {
            "model": "openrouter/anthropic/claude-sonnet-5",
            "reasoning": "medium"
          },
          {
            "model": "opencode-go/deepseek-v4.1-flash"
          },
          {
            "model": "opencode-go/glm-5.3-flash"
          }
        ]
      },
      "quick": {
        "models": [
          {
            "model": "openrouter/anthropic/claude-haiku-4.5"
          },
          {
            "model": "opencode-go/mimo-v2.5"
          },
          {
            "model": "opencode-go/qwen3.8-flash"
          }
        ]
      },
      "unspecified-low": {
        "models": [
          {
            "model": "openrouter/anthropic/claude-haiku-4.5"
          },
          {
            "model": "opencode-go/deepseek-v4-flash"
          },
          {
            "model": "opencode-go/mimo-v2.5"
          }
        ]
      },
      "unspecified-high": {
        "models": [
          {
            "model": "openrouter/anthropic/claude-sonnet-5",
            "reasoning": "medium"
          },
          {
            "model": "opencode-go/deepseek-v4.1-flash"
          },
          {
            "model": "opencode-go/glm-5.3-flash"
          }
        ]
      },
      "writing": {
        "models": [
          {
            "model": "openrouter/anthropic/claude-sonnet-5",
            "reasoning": "medium"
          },
          {
            "model": "opencode-go/glm-5.3-flash"
          },
          {
            "model": "opencode-go/qwen3.8-flash"
          }
        ]
      }
    }
  },
  "_migrations": [
    "2026-07-opencode-config-unification",
    "2026-08-reasoning-unification",
    "2026-09-anthropic-primary-cheap-fallback",
    "2026-09-category-deep-split"
  ]
}

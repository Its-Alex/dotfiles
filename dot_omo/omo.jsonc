// OMO configuration
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "agents": {
      "sisyphus": {
        "model": "openrouter/anthropic/claude-sonnet-5",
        "reasoning": "medium",
        "fallback_models": [
          {
            // Terminal-Bench 2.1 88.2, TB 3.0 28.3 (best open score on the hardest
            // version), AutomationBench 48.2 - post-trained specifically for
            // long-horizon agentic orchestration.
            "model": "opencode-go/glm-5.3"
          },
          {
            // Terminal-Bench 2.1 90.6, DeepSWE 74.2 - highest agentic-coding scores
            // in the whole opencode-go catalog, at flash-tier price.
            "model": "opencode-go/deepseek-v4.1-flash"
          }
        ]
      },
      "hephaestus": {
        // Hephaestus' system prompt is written for "an autonomous deep worker based
        // on GPT-5.6". gpt-5.6-luna is the only GPT model in opencode-go, so it is
        // the only prompt-native fit. GPQA 92.3, MMLU-Pro 86.0, 1.05M context.
        "model": "opencode-go/gpt-5.6-luna",
        "fallback_models": [
          {
            "model": "openrouter/anthropic/claude-sonnet-5",
            "reasoning": "medium"
          },
          {
            "model": "opencode-go/deepseek-v4.1-flash"
          }
        ]
      },
      "oracle": {
        // Read-only reasoning with no prompt-adherence stakes, so raw reasoning
        // scores dominate: Grok 4.6 posts GPQA 94.9 / MMLU-Pro 89.4 and a TB 2.1
        // of 88.4 independently measured by Artificial Analysis, while Sonnet 5
        // publishes no GPQA and scores 43.2 on HLE without tools.
        "model": "opencode-go/grok-4.6",
        "fallback_models": [
          {
            "model": "openrouter/anthropic/claude-sonnet-5",
            "reasoning": "xhigh"
          },
          {
            // GPQA 93.5, BrowseComp 91.2, DeepSWE 67.5, 1M context.
            "model": "opencode-go/kimi-k3"
          }
        ]
      },
      "librarian": {
        // Docs/OSS research: 1.05M context, native PDF input for spec reading,
        // GPQA 92.3, strong tool calling, $0.20/$1.20.
        "model": "opencode-go/gpt-5.6-luna",
        "fallback_models": [
          {
            "model": "opencode-go/glm-5.3-flash"
          },
          {
            "model": "opencode-go/qwen3.8-flash"
          }
        ]
      },
      "explore": {
        // Contextual grep is prefill-bound, not generation-bound. Qwen3.8 is the
        // only flash-tier model whose prefill rate *rises* with context
        // (1206 -> 2591 tok/s from 4K to 131K, vs flat for GLM/DeepSeek), so it
        // reads large context fastest. 1M window, $0.15/$0.47.
        "model": "opencode-go/qwen3.8-flash",
        "fallback_models": [
          {
            "model": "opencode-go/glm-5.3-flash"
          },
          {
            "model": "opencode-go/mimo-v2.5"
          }
        ]
      },
      "multimodal-looker": {
        // Best documented vision scores at flash price: CharXiv-R 89.4 (charts and
        // diagrams), MMVU 80.5, MVBench 77.8. Accepts image + video + PDF.
        "model": "opencode-go/glm-5.3-flash",
        "fallback_models": [
          {
            // VideoMME 90.4, RealWorldQA 88.0 - stronger on video and photographs.
            "model": "opencode-go/qwen3.8-max"
          },
          {
            // Only non-contributor model in the catalog that accepts audio input.
            "model": "opencode-go/mimo-v2-omni"
          }
        ]
      },
      "prometheus": {
        "model": "openrouter/anthropic/claude-sonnet-5",
        "reasoning": "medium",
        "fallback_models": [
          {
            "model": "opencode-go/grok-4.6"
          },
          {
            "model": "opencode-go/glm-5.3"
          }
        ]
      },
      "metis": {
        "model": "openrouter/anthropic/claude-sonnet-5",
        "reasoning": "medium",
        "fallback_models": [
          {
            "model": "opencode-go/grok-4.6"
          },
          {
            "model": "opencode-go/minimax-m3"
          }
        ]
      },
      "momus": {
        "model": "openrouter/anthropic/claude-sonnet-5",
        "reasoning": "medium",
        "fallback_models": [
          {
            "model": "opencode-go/grok-4.6"
          },
          {
            "model": "opencode-go/glm-5.3"
          }
        ]
      },
      "atlas": {
        // Atlas orchestrates a todo list via task() and never edits source, so
        // automation and long-horizon agent scores matter more than raw coding:
        // AutomationBench 48.2 (vs 25.1 for DeepSeek V4 Flash), Agents' Last
        // Exam 28.5, 1M context.
        "model": "opencode-go/glm-5.3",
        "fallback_models": [
          {
            // IFEval 90.0 - best instruction adherence in the catalog, which is
            // what keeps an orchestrator on its todo list.
            "model": "opencode-go/longcat-2.0"
          },
          {
            "model": "opencode-go/minimax-m3"
          }
        ]
      },
      "sisyphus-junior": {
        // High-volume focused executor: best quality-per-dollar in the catalog.
        // TB 2.1 90.6, DeepSWE 74.2, Codeforces 3471, 1M context, 384K max output,
        // at $0.15/$0.60.
        "model": "opencode-go/deepseek-v4.1-flash",
        "fallback_models": [
          {
            "model": "opencode-go/glm-5.3-flash"
          },
          {
            "model": "opencode-go/qwen3.8-flash"
          }
        ]
      }
    },
    "categories": {
      "visual-engineering": {
        "models": [
          {
            // CharXiv-R 89.4 on chart/diagram reading - the multimodal skill that
            // actually maps to UI review. Image + video + PDF at $0.15/$0.50.
            "model": "opencode-go/glm-5.3-flash"
          },
          {
            "model": "opencode-go/qwen3.8-max"
          },
          {
            "model": "openrouter/anthropic/claude-sonnet-5",
            "reasoning": "medium"
          }
        ]
      },
      "ultrabrain": {
        "models": [
          {
            "model": "openrouter/anthropic/claude-sonnet-5",
            "reasoning": "xhigh"
          },
          {
            // GPQA 94.9 / MMLU-Pro 89.4 - top reasoning pair in the catalog.
            "model": "opencode-go/grok-4.6"
          },
          {
            "model": "opencode-go/kimi-k3"
          }
        ]
      },
      "deep": {
        "models": [
          {
            // xhigh is Anthropic's stated setting for agentic tasks running over
            // 30 minutes, which is this category's definition.
            "model": "openrouter/anthropic/claude-sonnet-5",
            "reasoning": "xhigh"
          },
          {
            "model": "opencode-go/glm-5.3"
          },
          {
            "model": "opencode-go/deepseek-v4.1-flash"
          }
        ]
      },
      "artistry": {
        "models": [
          {
            "model": "opencode-go/grok-4.6"
          },
          {
            "model": "openrouter/anthropic/claude-sonnet-5",
            "reasoning": "medium"
          },
          {
            "model": "opencode-go/minimax-m3"
          }
        ]
      },
      "quick": {
        "models": [
          {
            // Cheapest non-contributor model in the catalog ($0.14/$0.28) that
            // still posts GPQA 84.9 / MMLU-Pro 82.9.
            "model": "opencode-go/mimo-v2.5"
          },
          {
            "model": "openrouter/anthropic/claude-haiku-4.5"
          },
          {
            "model": "opencode-go/qwen3.8-flash"
          }
        ]
      },
      "unspecified-low": {
        "models": [
          {
            // AA Intelligence Index 57 at $0.15/$0.50 - best intelligence-per-dollar
            // in the catalog.
            "model": "opencode-go/glm-5.3-flash"
          },
          {
            "model": "opencode-go/deepseek-v4-flash"
          },
          {
            "model": "opencode-go/mimo-v2.5"
          }
        ]
      },
      "unspecified-high": {
        "models": [
          {
            "model": "openrouter/anthropic/claude-sonnet-5",
            "reasoning": "medium"
          },
          {
            "model": "opencode-go/glm-5.3"
          },
          {
            // SWE-bench Verified 80.6, LiveCodeBench 93.5, Codeforces 3206.
            "model": "opencode-go/deepseek-v4-pro"
          }
        ]
      },
      "writing": {
        "models": [
          {
            // IFEval 90.0 - highest instruction-following score in the catalog,
            // which is the measurable proxy for following a writing brief.
            "model": "opencode-go/longcat-2.0"
          },
          {
            "model": "opencode-go/gpt-5.6-luna"
          },
          {
            // Kept at medium: prose is not intelligence-bottlenecked, and this is
            // the one slot where Anthropic's cost step-down is the right trade.
            "model": "openrouter/anthropic/claude-sonnet-5",
            "reasoning": "medium"
          }
        ]
      }
    }
  },
  "_migrations": [
    "2026-07-opencode-config-unification",
    "2026-08-reasoning-unification"
  ]
}

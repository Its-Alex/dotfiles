{{ if eq .chezmoi.osRelease.id "arch" -}}
#!/usr/bin/env bash
set -euo pipefail

# Enable pacman color
sudo sed -i '/^#Color/c\Color' /etc/pacman.conf

printf "\e[1;34m%s\e[1;0m\n" "Install Git..."
sudo pacman -S --noconfirm --needed git git-lfs base-devel

if ! command -v yay > /dev/null; then
    printf "\e[1;34m%s\e[1;0m\n" "Install Yay..."
    git clone https://aur.archlinux.org/yay.git /tmp/yay
    (
        cd /tmp/yay || exit 1
        makepkg -si --noconfirm --needed
    )
    rm -rf /tmp/yay
fi

printf "\e[1;34m%s\e[1;0m\n" "Install system programs.."
packages_list=(
    # System
    gnupg
    flatpak
    unzip
    tar
    fzf
    jq
    os-prober
    earlyoom # Raw %-memory/swap OOM backstop, complements PSI-pressure-based systemd-oomd
    fwupd
    systemd-resolvconf
    ## Keyboard
    xkb-qwerty-fr
    ## Fonts
    ttf-fira-code
    ttf-firacode-nerd
    ## Theme
    numix-square-icon-theme-git # Gnome icons
    flat-remix-gnome # Gnome theme
    numix-frost-themes # Legacy app
    # Netbird
    netbird
    # IDE
    vim
    nvim
    tree-sitter-cli
    # Terminal
    alacritty
    tmux
    tmuxinator
    zsh
    # Dev
    ## IDE
    visual-studio-code-bin
    cursor-bin
    cursor-cli
    opencode-bin
    rtk
    ## VPN
    networkmanager-openconnect
    ## Podman
    podman
    podman-docker
    docker-compose
    ## Qemu
    qemu-full
    guestfs-tools
    linux-headers
    ## Vagrant
    vagrant
    ## Jujutsu
    jujutsu
)
yay -S --noconfirm --needed "${packages_list[@]}"

# Install GPG key
{{ if and (ne (env "CHEZMOI_PASSWORD_MANAGER_DISABLED") "true") (ne (env "CHEZMOI_PASSWORD_MANAGER_DISABLED") "1") -}}
echo "{{ bitwardenAttachment "kb3rqexmcioe8716h20kgjlqsaqw197f" "e1ac83ba-e272-4b58-90eb-ae4c009cf0f7" }}" | GPG_TTY=$(tty) gpg --import -
{{ end -}}

# Setup podman
printf "\e[1;34m%s\e[1;0m\n" "Setup podman..."
sudo tee /etc/containers/registries.conf.d/10-unqualified-search-registries.conf > /dev/null <<'EOF'
unqualified-search-registries = ["docker.io"]
EOF
# Enable btrfs support for podman
sudo mkdir -p /etc/containers/storage.rootful.conf.d
sudo tee /etc/containers/storage.rootful.conf.d/99-btrfs.conf << 'EOF'
[storage]
driver = "btrfs"
EOF
# Enable podman socket for docker compose
systemctl --user enable --now podman.socket

# Initialize rtk OpenCode hooks
rtk init -g --opencode

flatpak_flathub_apps_list=(
    io.gitlab.librewolf-community
    org.signal.Signal
    com.slack.Slack
    com.discordapp.Discord
    md.obsidian.Obsidian
    org.videolan.VLC
    com.mattjakeman.ExtensionManager # Gnome extension manager
    com.obsproject.Studio
)
printf "\e[1;34m%s\e[1;0m\n" "Install flatpak programs.."
flatpak remote-add --if-not-exists --user flathub https://dl.flathub.org/repo/flathub.flatpakrepo
flatpak -y install --user flathub "${flatpak_flathub_apps_list[@]}"

# Set GTK theme to Adwaita for Signal and Slack to prevent glitches
# https://github.com/signalapp/Signal-Desktop/issues/7633
flatpak override --user --env=GTK_THEME=Adwaita org.signal.Signal
flatpak override --user --env=GTK_THEME=Adwaita com.slack.Slack

printf "\e[1;34m%s\e[1;0m\n" "Setup flatpak programs.."
# Allow Librewolf to access all devices (e.g. webcam)
flatpak override --user --device=all io.gitlab.librewolf-community

printf "\e[1;34m%s\e[1;0m\n" "Disable Xbox Wireless Adapter for Windows"
# Device Xbox Wireless Adapter for Windows was always appearing as Wifi Key
echo 'ACTION=="add", ATTR{idVendor}=="045e", ATTR{idProduct}=="02fe", ATTR{authorized}="0"' | sudo tee "/etc/udev/rules.d/99-disable-xbox-adapter.rules" > /dev/null
# Reload udev rules
sudo udevadm control --reload-rules
sudo udevadm trigger

{{ if eq .chezmoi.hostname "tp-pf-664dzm-alex" -}}
# Install and configure thermald
printf "\e[1;34m%s\e[1;0m\n" "Install thermald"
yay -S --noconfirm --needed thermald
sudo systemctl enable --now thermald
{{ end -}}

# Userspace OOM protection: systemd-oomd kills on PSI stall pressure, earlyoom
# on low available memory as a backstop for when pressure never crosses the
# threshold in time.
printf "\e[1;34m%s\e[1;0m\n" "Setup userspace OOMKiller (systemd-oomd + earlyoom)..."

# Only the reaction time needs tuning (20s, matching Ubuntu). The other limits
# stay stock: they are ratios, so already machine-relative.
sudo mkdir -p /etc/systemd/oomd.conf.d
sudo tee /etc/systemd/oomd.conf.d/10-interactive-desktop.conf > /dev/null <<'EOF'
[OOM]
DefaultMemoryPressureDurationSec=20s
EOF

# Arch leaves every cgroup at ManagedOOM*=auto, which oomd does not monitor, so
# it never kills whatever the limits say. Opt the user session in, as Ubuntu
# does. A kill takes one descendant cgroup (one app), not the whole session.
sudo mkdir -p /etc/systemd/system/user@.service.d
sudo tee /etc/systemd/system/user@.service.d/10-oomd.conf > /dev/null <<'EOF'
[Service]
ManagedOOMMemoryPressure=kill
ManagedOOMMemoryPressureLimit=50%
EOF

# Makes the stock 90% SwapUsedLimit effective. Delete for pressure-only kills.
sudo mkdir -p "/etc/systemd/system/-.slice.d"
sudo tee "/etc/systemd/system/-.slice.d/10-oomd.conf" > /dev/null <<'EOF'
[Slice]
ManagedOOMSwap=kill
EOF

# A fixed percentage does not port across machines: 10% is 819MiB on 8GiB RAM
# (too late to react) but 12.8GiB on 128GiB (fires far too early). Derive an
# absolute KiB floor from this host's RAM instead, clamped at both ends.
mem_total_kib=$(awk '/^MemTotal:/{print $2}' /proc/meminfo)
earlyoom_term_kib=$(( mem_total_kib / 10 ))
earlyoom_term_min_kib=$(( 1024 * 1024 ))     # 1 GiB
earlyoom_term_max_kib=$(( 4 * 1024 * 1024 )) # 4 GiB
if (( earlyoom_term_kib < earlyoom_term_min_kib )); then
    earlyoom_term_kib=$earlyoom_term_min_kib
fi
if (( earlyoom_term_kib > earlyoom_term_max_kib )); then
    earlyoom_term_kib=$earlyoom_term_max_kib
fi
earlyoom_kill_kib=$(( earlyoom_term_kib / 2 ))
earlyoom_kill_min_kib=$(( 512 * 1024 )) # 512 MiB
if (( earlyoom_kill_kib < earlyoom_kill_min_kib )); then
    earlyoom_kill_kib=$earlyoom_kill_min_kib
fi

printf "\e[1;34m%s\e[1;0m\n" "earlyoom thresholds: SIGTERM below $(( earlyoom_term_kib / 1024 ))MiB available, SIGKILL below $(( earlyoom_kill_kib / 1024 ))MiB"

# -M takes KiB; only -M is passed, never -m, because given both earlyoom keeps
# the lower value. -s 100 ignores free swap, which otherwise has to be low too:
# on a large swapfile that means minutes of thrashing first. This keeps the
# behaviour identical on zram, a big swapfile, or no swap at all.
# --avoid protects session-critical processes it must never kill.
sudo tee /etc/default/earlyoom > /dev/null <<EOF
EARLYOOM_ARGS="-M ${earlyoom_term_kib},${earlyoom_kill_kib} -s 100 -r 3600 --avoid '(^|/)(dbus-daemon|dbus-broker|systemd|systemd-logind|gnome-shell|gnome-session|Xorg|sshd)\$'"
EOF

sudo systemctl daemon-reload
sudo systemctl enable --now systemd-oomd
sudo systemctl restart systemd-oomd # apply oomd.conf.d override if already running
sudo systemctl enable --now earlyoom

# Setup systemd-resolved with NetworkManager
sudo systemctl enable --now systemd-resolved.service
sudo ln -sf ../run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
{{ end -}}

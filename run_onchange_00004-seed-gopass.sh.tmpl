{{ if and (ne (env "CHEZMOI_PASSWORD_MANAGER_DISABLED") "true") (ne (env "CHEZMOI_PASSWORD_MANAGER_DISABLED") "1") -}}
#!/usr/bin/env bash
set -euo pipefail

# Copy the Bitwarden items the dotfiles consume into the local `bitwarden` gopass
# mount (created by run_onchange_00002-setup-gopass.sh.tmpl). Bitwarden stays the
# source of truth: an edit made in gopass is overwritten by the next change here.
gopass_bin="$(command -v gopass || true)"
if [ -z "$gopass_bin" ] && command -v mise > /dev/null; then
    gopass_bin="$(mise which gopass 2> /dev/null || true)"
fi
if [ -z "$gopass_bin" ]; then
    printf "\e[1;33m%s\e[1;0m\n" "gopass not found; skipping store seeding."
    exit 0
fi

# Same source as the identity installation: the passphrase comes from Bitwarden
# so seeding never prompts (see run_onchange_00002-setup-gopass.sh.tmpl).
age_keyring_pass="{{ with (index (bitwardenFields "item" "Age - gopass identity") "gopass-keyring-pass") }}{{ .value }}{{ end }}"

# Absent when the Bitwarden field is missing: exporting nothing lets gopass fall
# back to the OS keyring instead of being handed an empty passphrase.
if [ -n "$age_keyring_pass" ]; then
    export GOPASS_AGE_PASSWORD="$age_keyring_pass"
fi

mirror_name="bitwarden"

# Without the mount, `bitwarden/...` would become a plain folder of the git-backed
# root store and be pushed along with it.
if ! "$gopass_bin" --nosync mounts 2> /dev/null | grep -qF "${mirror_name} ("; then
    printf "\e[1;33m%s\e[1;0m\n" "gopass mount \"${mirror_name}\" missing; skipping store seeding."
    exit 0
fi

printf "\e[1;34m%s\e[1;0m\n" "Seed the ${mirror_name} gopass mount from Bitwarden..."

# Usage: seed_mirror_entry <entry> <password> [<key> <value>]...
# The password is the first line and each pair becomes a `key: value` line, read
# back with `gopass show <entry> <key>`.
#
# An empty value usually means a renamed or mistyped Bitwarden item, and writing
# it would clobber a working entry. An unchanged entry is not rewritten.
seed_mirror_entry() {
    local entry="${mirror_name}/$1" password="$2" content current
    shift 2
    if [ -z "$password" ]; then
        printf "\e[1;33m%s\e[1;0m\n" "Bitwarden password for ${entry} is empty; leaving the stored entry untouched."
        return 0
    fi
    content="$password"
    while [ "$#" -ge 2 ]; do
        if [ -z "$2" ]; then
            printf "\e[1;33m%s\e[1;0m\n" "Bitwarden field \"$1\" for ${entry} is empty; leaving the stored entry untouched."
            return 0
        fi
        content="${content}"$'\n'"$1: $2"
        shift 2
    done
    current="$("$gopass_bin" --nosync show --unsafe --noparsing "$entry" 2> /dev/null || true)"
    [ "$current" = "$content" ] && return 0
    printf '%s' "$content" | "$gopass_bin" --nosync insert --force "$entry"
}

seed_mirror_entry gitlab/api-token "{{ (bitwarden "item" "Gitlab - API Token").login.password }}"
seed_mirror_entry linear/api-key "{{ (bitwarden "item" "Linear - API Key").login.password }}"
seed_mirror_entry terraform/api-token "{{ (bitwarden "item" "Terraform - API Token").login.password }}"
seed_mirror_entry atlassian/confluence "{{ (bitwarden "item" "Confluence - API Token").login.password }}" \
    url "{{ (bitwardenFields "item" "Confluence - API Token").space_url.value }}" \
    username "{{ (bitwarden "item" "Confluence - API Token").login.username }}"
seed_mirror_entry atlassian/jira "{{ (bitwarden "item" "Jira - API Token ").login.password }}" \
    url "{{ (bitwardenFields "item" "Jira - API Token ").space_url.value }}" \
    username "{{ (bitwarden "item" "Jira - API Token ").login.username }}"

printf "\e[1;32m%s\e[1;0m\n" "${mirror_name} gopass mount seeded."
{{ end -}}

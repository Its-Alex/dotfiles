#!/usr/bin/env bash

# Ambient secrets come from the age-encrypted `bitwarden` gopass mount, seeded
# from Bitwarden, so no token is written in cleartext. Atlassian and Linear are
# deliberately NOT exported: the ~/.local/bin wrappers read them per invocation,
# keeping them out of the shell and its children. The timeout bounds a locked
# store so start-up cannot block on it.
_gopass_export() {
    local name="$1" entry="$2" value
    value="$(timeout 3 gopass show --password "$entry" 2>/dev/null)" || return 0
    [ -n "$value" ] && export "$name=$value"
    return 0
}

{{ if eq .chezmoi.os "darwin" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"

{{ end -}}
export ZSH=$HOME/.oh-my-zsh
#  shellcheck disable=SC2034 # Set name of the oh_my_zsh theme to load
ZSH_THEME="robbyrussell"
#  shellcheck disable=SC2034 # Set oh_my_zsh plugins
plugins=(
    git
    jj
    git-extras
    docker
    extract
    fzf
    z
    terraform
    opentofu
)
#  Regenerate gopass completion into the oh-my-zsh cache, which is on fpath.
if [[ $- == *i* ]] && command -v gopass > /dev/null 2>&1; then
    _gopass_completion="${ZSH}/cache/completions/_gopass"
    if [[ ! -s "$_gopass_completion" || "$(command -v gopass)" -nt "$_gopass_completion" ]]; then
        mkdir -p "${_gopass_completion:h}"
        gopass completion zsh >| "$_gopass_completion"
    fi
    unset _gopass_completion
fi
export UPDATE_ZSH_DAYS=15
#  shellcheck source=/dev/null # Load oh_my_zsh
source "${ZSH}/oh-my-zsh.sh"

# Disable url-quote-magic (oh-my-zsh escapes special chars like ?, =, & on paste)
zle -A .self-insert self-insert

export PATH=/usr/local/bin:$PATH
export PATH=/usr/local/sbin:$PATH
export LANG=en_US.UTF-8
export EDITOR='nvim'
export FZF_DEFAULT_OPTS="--tmux"
GPG_TTY=$(tty)
export GPG_TTY
{{ if (and (eq .chezmoi.osRelease.id "arch") (ne .chezmoi.os "darwin")) -}}
export SSH_AUTH_SOCK=$XDG_RUNTIME_DIR/gcr/ssh
{{- end }}
if [ -S "${XDG_RUNTIME_DIR:-/run/user/$UID}/podman/podman.sock" ]; then
    export DOCKER_HOST="unix://${XDG_RUNTIME_DIR:-/run/user/$UID}/podman/podman.sock"
fi
# Interactive shells only: a non-interactive shell must never trigger pinentry.
if [[ $- == *i* ]] && command -v gopass >/dev/null 2>&1; then
    # Gitlab (used by CLI tools such as glab)
    _gopass_export GITLAB_PERSONAL_ACCESS_TOKEN bitwarden/gitlab/api-token
fi

export PATH=$PATH:$HOME/.cargo/bin
export GOPATH=$HOME/go
export PATH=$PATH:$HOME/go/bin
export CC_SAFETY_NET_PARANOID_RM=1
export CC_SAFETY_NET_WORKTREE=1
{{ if eq .chezmoi.os "darwin" -}}
export PATH="/usr/local/opt/coreutils/libexec/gnubin:$PATH"
export ANDROID_SDK_ROOT="/usr/local/share/android-sdk"
export PATH=$ANDROID_SDK_ROOT:$PATH
export HOMEBREW_INSTALL_CLEANUP=1
{{ else if eq .chezmoi.os "linux" -}} 
export PATH=$PATH:$HOME/.local/bin
export ANDROID_SDK_ROOT=/opt/android-sdk
export PATH="${ANDROID_SDK_ROOT}/platform-tools:$PATH"
export PATH="${ANDROID_SDK_ROOT}/tools:$PATH"
{{- end }}

if [ -x "$(command -v mise)" ]; then
    eval "$(mise activate zsh)"

    if [ -x "$(mise which direnv)" ]; then
        eval "$($(mise which direnv) hook zsh)"
    fi
fi

alias ls="ls --color=auto"
alias rsync-remote-sudo="rsync -avHAXS --numeric-ids --rsync-path='sudo rsync'"
alias vim="nvim"
